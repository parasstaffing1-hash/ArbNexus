# ==============================================
# CRYPTO ARBITRAGE PLATFORM - ENVIRONMENT CONFIG
# ==============================================

# Node Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://arbitrage_user:arbitrage_secure_pass_2026@localhost:5432/arbitrage_db?schema=public
POSTGRES_USER=arbitrage_user
POSTGRES_PASSWORD=arbitrage_secure_pass_2026
POSTGRES_DB=arbitrage_db
POSTGRES_PORT=5432

# Redis / Valkey Cache & Message Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=valkey_secure_pass_2026

# JWT Secret
JWT_SECRET=super_secret_jwt_key_crypto_arbitrage_2026_production

# Web3 / EVM RPC URLs
ETHEREUM_RPC_URL=https://eth.llamarpc.com
POLYGON_RPC_URL=https://polygon-rpc.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
BASE_RPC_URL=https://mainnet.base.org

# Solana RPC URLs
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# DEX API Keys
ONEINCH_API_KEY=your_1inch_dev_portal_api_key
LIFI_API_KEY=your_lifi_api_key
JUPITER_API_KEY=your_jupiter_api_key

# Centralized Exchange API Keys (CCXT / Hummingbot)
BINANCE_API_KEY=your_binance_key
BINANCE_SECRET=your_binance_secret
OKX_API_KEY=your_okx_key
OKX_SECRET=your_okx_secret
OKX_PASSPHRASE=your_okx_passphrase
COINBASE_API_KEY=your_coinbase_key
COINBASE_SECRET=your_coinbase_secret

# AI Providers
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_TRACING_V2=false

# Notifications
NOVU_API_KEY=your_novu_api_key
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Next.js Public Variables
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=demo_wallet_connect_project_id

# ==============================================
# REAL-TIME EVENT BUS & ANALYTICS (NATS & ClickHouse)
# ==============================================
EVENT_BUS=nats
NATS_URL=nats://localhost:4222
NATS_USER=
NATS_PASSWORD=

ANALYTICS_BACKEND=clickhouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=arbitrage_analytics

# Data Ingestion Mode: 'live' | 'demo' | 'replay' | 'backtest'
DATA_MODE=demo

# ==============================================
# OBJECT STORAGE / DATA LAKE (Cloudflare R2 / S3)
# ==============================================
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=arbnexus-datasets
R2_REGION=auto

# ==============================================
# SECURITY & SECRETS VAULT (OpenBao / HashiCorp Vault)
# ==============================================
AUTH_SECRET=arbnexus_better_auth_secret_key_change_in_production_32chars
OPENBAO_ADDR=http://localhost:8200
OPENBAO_TOKEN=
SECRETS_MOUNT_PATH=secret/arbnexus

# ==============================================
# OBSERVABILITY & TELEMETRY (OpenTelemetry / Prometheus)
# ==============================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=arbnexus-backend
PROMETHEUS_METRICS_PORT=9090
LOG_LEVEL=info

# ==============================================
# ARBNEXUS MULTI-VENUE & ZERO-EXECUTION FLAGS
# ==============================================
ENABLE_DEX=true
ENABLE_CROSS_CHAIN=true
ENABLE_ONCHAIN=true
ENABLE_MEV=false
ENABLE_FLASH_LOAN_SIMULATION=true
ENABLE_EXECUTION=false
