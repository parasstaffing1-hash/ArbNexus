{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@arbitrage/shared": ["../../packages/shared/src"],
      "@arbitrage/shared/*": ["../../packages/shared/src/*"],
      "@arbitrage/ui": ["../../packages/ui/src"],
      "@arbitrage/ui/*": ["../../packages/ui/src/*"],
      "@arbitrage/crypto": ["../../packages/crypto/src"],
      "@arbitrage/crypto/*": ["../../packages/crypto/src/*"],
      "@arbitrage/analytics": ["../../packages/analytics/src"],
      "@arbitrage/analytics/*": ["../../packages/analytics/src/*"],
      "@arbitrage/ai": ["../../packages/ai/src"],
      "@arbitrage/ai/*": ["../../packages/ai/src/*"],
      "@arbitrage/notifications": ["../../packages/notifications/src"],
      "@arbitrage/notifications/*": ["../../packages/notifications/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
